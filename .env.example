# Copy this file to .env.local (or save directly from the Studio Configuration page).
# Never commit .env.local.
# LiveKit Cloud Project: https://cloud.livekit.io/projects/p_jg0goo2oksb/agents/CA_tBWDFVRz7pZS
LIVEKIT_URL=wss://medicare-bot-z2uz9h17.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Cloud Agent Dashboard URL / Dispatch Target:
# - Set to `CA_tBWDFVRz7pZS` for your hosted LiveKit Cloud bot (`https://cloud.livekit.io/projects/p_jg0goo2oksb/agents/CA_tBWDFVRz7pZS`)
# - Leave blank or select "Automatic dispatch" in the Studio UI for unnamed auto-dispatched Cloud Agents
# - Set to `inference-studio` when running the local Python Studio worker (`python -m backend.agent dev`)
LIVEKIT_AGENT_URL=https://cloud.livekit.io/projects/p_jg0goo2oksb/agents/CA_tBWDFVRz7pZS
LIVEKIT_AGENT_NAME=CA_tBWDFVRz7pZS

# Default pipeline for standalone `agent.py` / `agent-node`: `stt-llm-tts` or `realtime`.
LIVEKIT_PIPELINE=stt-llm-tts
LIVEKIT_REALTIME_MODEL=openai/gpt-realtime-2.1
LIVEKIT_REALTIME_VOICE=marin

# Set to `false` when self-hosting open-source LiveKit Server without Cloud ai-coustics noise cancellation.
LIVEKIT_NOISE_CANCELLATION=true

# Optional development access token. Recommended if your preview is shared.
STUDIO_ACCESS_TOKEN=

# --- Publishing on a LAN / public IP ------------------------------------------------
# Browsers only allow microphone access over HTTPS or localhost. `start.py --https`
# generates a self-signed certificate in ./certs covering localhost, this machine's
# LAN addresses, and any --host you publish on (e.g. your public IP).
# Strongly recommended whenever the Studio is reachable from another machine:
# STUDIO_ACCESS_TOKEN=replace-with-a-long-random-string   # see PUBLISH_IP.md §7
