# Wave 2.0 Studio as a systemd service (Linux): survives logout, crashes and reboots.
#
#   sudo useradd --system --create-home --home-dir /opt/wave-2.0 wave
#   sudo git clone https://github.com/muneeb819/Wave-2.0.git /opt/wave-2.0
#   cd /opt/wave-2.0 && sudo -u wave uv sync && sudo -u wave pnpm install && sudo -u wave pnpm run build
#   sudo -u wave python3 - <<'PY'   # create .env.local with LIVEKIT_* + STUDIO_ACCESS_TOKEN
#   sudo cp deploy/wave-studio.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now wave-studio
#   systemctl status wave-studio && journalctl -u wave-studio -f
#
# Serving on port < 1024 needs AmbientCapabilities=CAP_NET_BIND_SERVICE (already set).
# For a domain with a real certificate, put Caddy/nginx in front and drop --https here.

[Unit]
Description=Wave 2.0 Studio (HTTPS)
Documentation=file:/opt/wave-2.0/DEPLOYMENT.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wave
Group=wave
WorkingDirectory=/opt/wave-2.0
EnvironmentFile=-/opt/wave-2.0/.env.local
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/opt/wave-2.0/.venv/bin/python start.py --preflight --mode prod --https --host 0.0.0.0 --port 8443
ExecStart=/opt/wave-2.0/.venv/bin/python start.py --mode prod --https --host 0.0.0.0 --port 8443 --no-open --no-worker
Restart=always
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGINT

# Basic hardening: /etc, /usr, /home and the rest of the filesystem stay read-only;
# the service may only write inside its own directory (certs/, dist/, .env.local).
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/opt/wave-2.0
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
