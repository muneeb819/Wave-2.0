{
  "name": "livekit-inference-studio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.15.0"
  },
  "scripts": {
    "start": "python3 start.py || python start.py",
    "serve": "python3 start.py --mode prod --host 0.0.0.0 --port 8000 || python start.py --mode prod --host 0.0.0.0 --port 8000",
    "publish": "python3 start.py --mode prod --https --host 0.0.0.0 --port 8443 || python start.py --mode prod --https --host 0.0.0.0 --port 8443",
    "e2b:proxy": "node scripts/e2b-traffic-proxy.mjs",
    "dev": "vite --host 0.0.0.0",
    "lint": "eslint --max-warnings 0 src tests",
    "typecheck": "tsc --noEmit",
    "build": "tsc -b && vite build",
    "build:docs": "pnpm run build && node scripts/sync-docs.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:api": "python -m pytest tests -q",
    "test:dom": "vitest run",
    "test:ui": "playwright test",
    "test": "vitest run",
    "test:all": "npm run test:api && npm run test:dom",
    "api": "python -m uvicorn backend.main:app --host 0.0.0.0 --port 8000 --no-proxy-headers",
    "agent": "python -m backend.agent dev",
    "agent:console": "python agent.py console",
    "agent:start": "python -m backend.agent start"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.6",
    "@fontsource/jetbrains-mono": "^5.2.6",
    "livekit-client": "^2.23.0",
    "lucide-react": "^1.65.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}
