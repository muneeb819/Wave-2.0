# Copy this file to .env.local. Never commit .env.local.
# Credentials: LiveKit Cloud → Project → Settings → API keys.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Must match the Python worker's dispatch name.
LIVEKIT_AGENT_NAME=inference-studio

# Optional development access token. Recommended if your preview is shared.
# Set a strong random value, then enter it in the app's connection settings.
# Add real application authentication before any production deployment.
STUDIO_ACCESS_TOKEN=
