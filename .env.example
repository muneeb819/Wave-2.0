# ============================================================================
# Wave 2.0 — LiveKit Inference Voice AI Studio & Agent Environment Template
# Copy to .env.local (`cp .env.example .env.local`). Never commit .env.local.
# See SECURITY.md for secret manager integrations (Vault, Doppler, *_FILE).
# ============================================================================

# --- Core LiveKit Cloud / Self-Hosted Credentials ---
# Obtain from https://cloud.livekit.io -> Project Settings -> Keys (or `lk app env -w`).
LIVEKIT_URL=wss://medicare-bot-z2uz9h17.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# --- LiveKit Agent Dispatch Configuration ---
# Pre-configured LiveKit Cloud bot agent ID & link (Project ID: p_jg0goo2oksb).
# Leave LIVEKIT_AGENT_NAME blank to let any automatic / default worker join rooms.
LIVEKIT_AGENT_NAME=CA_tBWDFVRz7pZS
LIVEKIT_AGENT_URL=https://cloud.livekit.io/projects/p_jg0goo2oksb/agents/CA_tBWDFVRz7pZS
# Dispatch mode: pinned | auto | custom
LIVEKIT_DISPATCH_MODE=pinned
# Optional LiveKit Cloud Token Server Sandbox ID for browser-direct token minting
LIVEKIT_SANDBOX_ID=

# --- Studio Access Control & Reverse-Proxy Hardening ---
# Required whenever publishing the Studio beyond localhost (`>= 32` chars recommended).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
STUDIO_ACCESS_TOKEN=
# Comma-separated browser origins allowed to call mutating POST endpoints
STUDIO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set true only behind a trusted reverse proxy that overwrites X-Forwarded-For / Proto
STUDIO_TRUST_PROXY=false
# Emit Strict-Transport-Security when requests arrive over HTTPS
STUDIO_ENABLE_HSTS=true

# --- External Secret Providers (backend/secrets.py) ---
# Provider selection: env | file | vault | doppler
SECRET_PROVIDER=env
# Docker / Kubernetes / systemd mounted secret files (used when SECRET_PROVIDER=file or set directly)
LIVEKIT_URL_FILE=
LIVEKIT_API_KEY_FILE=
LIVEKIT_API_SECRET_FILE=
STUDIO_ACCESS_TOKEN_FILE=
# HashiCorp Vault KV v2 (used when SECRET_PROVIDER=vault)
VAULT_ADDR=
VAULT_TOKEN=
VAULT_SECRET_PATH=secret/data/wave-studio
VAULT_NAMESPACE=
# Doppler Secrets Manager (used when SECRET_PROVIDER=doppler)
DOPPLER_TOKEN=

# --- Structured Logging & Error Tracking ---
# Log verbosity for structlog JSON renderer: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Optional Sentry DSN (`send_default_pii=False` enforced)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Launcher (`start.py`), Vite Dev Server, and Container Ports ---
# Launch mode: dev | prod
WAVE_MODE=dev
WAVE_HOST=127.0.0.1
WAVE_API_PORT=8000
PORT=8443
VITE_HOST=127.0.0.1
VITE_PORT=5173
VITE_API_TARGET=http://127.0.0.1:8000
VITE_HTTPS_CERT=
VITE_HTTPS_KEY=

# --- Container Build & Test Runner Overrides (Optional) ---
PYTHON_VERSION=3.13
NODE_VERSION=22
UID=10001
VITEST_PYTHON_BIN=
PLAYWRIGHT_BASE_URL=http://127.0.0.1:5173
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# --- Optional E2B Cloud Sandbox Preview Variables ---
E2B_SANDBOX_ID=
E2B_HOST=
E2B_TRAFFIC_ACCESS_TOKEN=
LOCAL_PORT=5173
TARGET_PORT=8000
